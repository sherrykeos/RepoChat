# ==========================================
# RepoChat Backend Environment Template (.env.example)
# Copy this file to .env inside the backend directory
# ==========================================

# AI Providers
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# AI Provider Selection (options: gemini, openai)
AI_CHAT_PROVIDER=gemini
AI_EMBEDDING_PROVIDER=gemini

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5433/repochat
DB_USERNAME=postgres
DB_PASSWORD=postgres

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Security & Encryption
APP_TOKEN_ENCRYPTOR_PASSWORD=your-token-encryptor-password
APP_TOKEN_ENCRYPTOR_SALT=your-token-encryptor-salt

# App URLs & CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server & Session (Render binds PORT automatically; use none/true in cross-origin prod)
PORT=8080
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
